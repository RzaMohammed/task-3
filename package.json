{
  "name": "face-blockchain-verifier-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo workspace for Face Recognition Blockchain Verification Pipeline",
  "scripts": {
    "test": "npm --prefix backend test",
    "test:backend": "npm --prefix backend test",
    "test:unit": "npm --prefix backend run test:unit",
    "test:integration": "npm --prefix backend run test:integration",
    "cache:clean": "node scripts/clear-cache.js",
    "bench:hashing": "node scripts/benchmark-hashing.js",
    "verify:bundle": "node scripts/verify-bundle.js",
    "env:check": "node scripts/check-env.js",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",

    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "RzaMohammed",
  "license": "MIT"
}
